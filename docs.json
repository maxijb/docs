{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "BitSetJS",
  "description": "Memory-efficient bit arrays for JavaScript.",
  "colors": {
    "primary": "#2563EB",
    "light": "#DBEAFE",
    "dark": "#1E3A8A"
  },
  "favicon": "/favicon.svg",
  "metadata": {
    "og:image": "/logo/og.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Core API",
            "icon": "brackets-curly",
            "pages": [
              "api/constructor",
              "api/bit-operations",
              "tutorials/memory-model"
            ]
          }
        ]
      },
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              {
                "group": "Basics",
                "pages": [
                  "installation",
                  "quickstart",
                  {
                    "group": "Runtimes",
                    "icon": "server",
                    "pages": [
                      "tutorials/node-usage",
                      "tutorials/bun"
                    ]
                  }
                ]
              },
              {
                "group": "Edge & serverless",
                "pages": [
                  "tutorials/deno-runtime"
                ]
              }
            ]
          },
          {
            "group": "Concepts",
            "icon": "graduation-cap",
            "pages": [
              "concepts/bitset-basics"
            ]
          },
          {
            "group": "Serialization",
            "icon": "code",
            "pages": [
              "api/serialization",
              "concepts/utilities"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "pages": [
          "Benchmarks",
          {
            "group": "Browser",
            "pages": [
              "tutorials/browser-usage",
              "tutorials/typescript"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "openapi": [
      "openapi.yml"
    ],
    "playground": {
      "display": "interactive",
      "proxy": false
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://example.com/community"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/maxijb/BitSetJS"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/example",
      "github": "https://github.com/maxijb/BitSetJS"
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-TEST000000"
    }
  },
  "redirects": [
    {
      "source": "/old-intro",
      "destination": "/introduction"
    },
    {
      "source": "/concepts/:slug*",
      "destination": "/api/:slug*"
    },
    {
      "source": "/how-to/:slug*",
      "destination": "/guides/:slug*"
    },
    {
      "source": "/docs/getting-started",
      "destination": "/quickstart"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/runtimes/deno",
      "destination": "/guides/deno-runtime"
    },
    {
      "source": "/benchmarks/:slug*",
      "destination": "/Benchmarks"
    }
  ]
}
