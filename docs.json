{
  "$schema": "https://mintlify.com/docs.json",
  "name": "BitSetJS",
  "theme": "luma",
  "colors": {
    "primary": "#2563EB",
    "light": "#DBEAFE",
    "dark": "#1E3A8A"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/maxijb/BitSetJS"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "pages": [
          "api/utilities",
          "quickstart",
          "introduction",
          "installation"
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "concepts/bitset-basics",
          "guides/memory-model",
          "api/constructor",
          "api/bit-operations",
          "api/serialization"
        ]
      },
      {
        "tab": "Guides",
        "pages": [
          "guides/browser-usage",
          "guides/commonjs-usage",
          {
            "group": "Advanced",
            "pages": [
              "guides/es5-compatibility"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/old-intro",
      "destination": "/introduction"
    },
    {
      "source": "/concepts/:slug*",
      "destination": "/api/:slug*"
    },
    {
      "source": "/how-to/:slug*",
      "destination": "/guides/:slug*"
    }
  ]
}
